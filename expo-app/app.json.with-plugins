{
  "expo": {
    "name": "Streambert",
    "slug": "streambert-android",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "streambert",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.truelockmc.streambert",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21,
            "targetSdkVersion": 34,
            "compileSdkVersion": 34
          }
        }
      ],
      "./plugins/with-external-player",
      "./plugins/with-external-player-native"
    ],
    "extra": {
      "eas": {
        "projectId": "87b68f14-d33e-4ca6-91db-a0c97f85764e"
      }
    },
    "owner": "bjvgghb777s-team"
  }
}
